{
  "name": "musical",
  "private": true,
  "version": "0.6.4",
  "license": "MIT",
  "author": "yaztak1227@gmail.com",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build:mcp": "tsc -p tsconfig.mcp.json && node scripts/bundle-mcp.mjs",
    "dev": "vite",
    "dev:public": "npm run build:mcp && npm run prepare:node-runtime && node scripts/public-dev.mjs",
    "prebuild": "npm run test:agent-plugin",
    "build": "tsc && vite build && npm run build:mcp && npm run prepare:node-runtime",
    "mcp:dev": "npm run build:mcp && node dist/mcp/server.js",
    "mcp:smoke": "npm run build:mcp && node scripts/mcp-ai-sdk-smoke.mjs",
    "prepare:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "test:agent-plugin": "node --test tests/agent-plugin.test.mjs",
    "preview": "vite preview",
    "test:mcp": "npm run build:mcp && npm run prepare:node-runtime && node --test tests/mcp/*.test.mjs",
    "test:release-packaging": "node --test tests/release-packaging.test.mjs",
    "verify:release": "node scripts/verify-release-bundle.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cache:status": "node scripts/prune-build-cache.mjs --status",
    "cache:prune": "node scripts/prune-build-cache.mjs --force",
    "pretauri": "node scripts/prune-build-cache.mjs",
    "tauri:dev:ai-test": "node scripts/ai-init-test.mjs",
    "pretauri:dev:windows": "node scripts/prune-build-cache.mjs",
    "tauri:dev:windows": "powershell -ExecutionPolicy Bypass -File scripts/tauri-dev-localappdata.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tsparticles/react": "^4.1.3",
    "@tsparticles/slim": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "cloudflared": "^0.7.1",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
