{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musical",
  "version": "0.6.5",
  "identifier": "com.circularmoonray.musical",
  "build": {
    "beforeDevCommand": "npm run dev:public",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Musical",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$AUDIO/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/THIRD_PARTY_NOTICES.txt": "resources/THIRD_PARTY_NOTICES.txt",
      "resources/ONNX_RUNTIME_1.28.0_THIRD_PARTY_NOTICES.txt": "resources/ONNX_RUNTIME_1.28.0_THIRD_PARTY_NOTICES.txt",
      "../dist-mcp/server.mjs": "mcp/server.mjs",
      "../build/node/LICENSE.txt": "resources/NODE_RUNTIME_LICENSE.txt"
    },
    "externalBin": ["binaries/musical-node"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
