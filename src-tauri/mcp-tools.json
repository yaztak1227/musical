  {
    "name": "search_tracks",
    "title": "Search Tracks",
    "description": "Search track metadata and saved lyrics with local multilingual semantic or hybrid matching and optional coverage-weighted sentiment similarity.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "semantic",
            "hybrid"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "all",
            "lyrics",
            "metadata"
          ]
        },
        "lyricsOnly": {
          "type": "boolean"
        },
        "favoriteOnly": {
          "type": "boolean"
        },
        "minRating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "genres": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludeTrackIds": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sentimentWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "_meta": {
      "musical/modelVisible": true,
      "musical/risk": "read"
    }
  },
  {
    "name": "recommend_tracks",
    "title": "Recommend Tracks",
    "description": "Recommend tracks for a natural-language mood using local semantic and coverage-weighted sentiment similarity over metadata and saved lyrics, with diversity and duration controls.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "prompt": {
